# CRM connection for the Investor Agent tools
CRM_API_URL=http://localhost:3000/api/graphql
CRM_AGENT_KEY=dev-agent-key-change-me

# Shared secret the CRM must present when calling the draft-outreach webhook
WEBHOOK_SHARED_SECRET=pick-a-long-random-string

# A5 / image21: where an investor is sent when a channel cannot identify them
# (web chat has no verified sender). Falls back to the production host if unset.
PORTAL_URL=https://noble-stride.vercel.app/portal/investor
